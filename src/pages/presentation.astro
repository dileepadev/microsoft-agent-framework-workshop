        .maf-key-list,
        .maf-card-desc,
        .agent-hub-spoke p,
        .loop-node-desc,
        .tc-sub,
        .mcp-box-desc,
        .mflow-node span,
        .memory-list,
        .wf-node-desc,
        .ops-cap-card p,
