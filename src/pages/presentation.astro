      box-shadow: 0 12px 32px -8px rgba(99, 102, 241, 0.12);
    }

    .speaker-card img {
      width: 68px;
      height: 68px;
      border-radius: 999px;
      object-fit: cover;
      border: 2px solid rgba(99, 102, 241, 0.35);
    }

    .speaker-name {
      margin: 0;
      font-size: 1.1rem;
      font-weight: 800;
      color: rgb(17 24 39);
    }

    .speaker-role {
      margin: 0.1rem 0 0.3rem;
      font-size: 0.88rem;
      color: rgb(75 85 99);
    }

    .speaker-links {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: 0.3rem;
    }

    .speaker-link {
      font-size: 0.85rem;
      color: rgb(37 99 235);
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      transition: color 0.2s ease;
    }

    :global(.dark) .speaker-link {
      color: rgb(96 165 250);
    }

    .speaker-link:hover {
      text-decoration: underline;
      color: rgb(29 78 216);
    }

    :global(.dark) .speaker-link:hover {
      color: rgb(147 197 253);
    }

    .link-divider {
      color: rgb(156 163 175);
      font-size: 0.8rem;
    }

    /* ══════════ SLIDE 1 – TWO-COLUMN HERO LAYOUT ══════════ */
    .slide1-layout {
      display: grid;
      grid-template-columns: 3fr 2fr;
      align-items: stretch;
      gap: 0;
      flex: 1;
      width: 100%;
    }
    .slide1-left {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.9rem;
      padding-right: 3rem;
    }
    .slide1-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.25rem;
    }
    .slide1-tags span {
      border: 1px solid rgba(99, 102, 241, 0.35);
      background: rgba(99, 102, 241, 0.08);
      color: rgb(79 70 229);
      padding: 0.28rem 0.75rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    :global(.dark) .slide1-tags span {
      border-color: rgba(129, 140, 248, 0.35);
      background: rgba(99, 102, 241, 0.15);
      color: rgb(165 180 252);
    }
    .slide1-right {
      display: flex;
      align-items: stretch;
      justify-content: center;
      padding-left: 3rem;
      border-left: 1px solid rgba(148, 163, 184, 0.2);
    }
    :global(.dark) .slide1-right {
      border-left-color: rgba(255, 255, 255, 0.08);
    }
    .speaker-card-hero {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.7rem;
      padding: 2.2rem 2rem;
      border: 1px solid rgba(99, 102, 241, 0.28);
      border-radius: 1.75rem;
      background: rgba(255, 255, 255, 0.82);
      text-align: center;
      overflow: hidden;
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
      width: 100%;
      max-width: 280px;
    }
    .speaker-card-hero:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 48px -12px rgba(99, 102, 241, 0.2);
    }
    :global(.dark) .speaker-card-hero {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(129, 140, 248, 0.25);
    }
    .speaker-hero-glow {
      position: absolute;
      top: -60px;
      left: 50%;
      transform: translateX(-50%);
      width: 240px;
      height: 240px;
      border-radius: 999px;
      background: radial-gradient(
        circle,
        rgba(99, 102, 241, 0.18),
        transparent 65%
      );
      pointer-events: none;
    }
    .speaker-hero-photo-wrap {
      position: relative;
      z-index: 1;
    }
    .speaker-hero-photo-wrap img {
      width: 170px;
      height: 170px;
      border-radius: 999px;
      object-fit: cover;
      border: 4px solid rgba(99, 102, 241, 0.55);
      box-shadow:
        0 0 0 8px rgba(99, 102, 241, 0.1),
        0 12px 32px -6px rgba(99, 102, 241, 0.35);
      display: block;
    }
    .speaker-name-hero {
      margin: 0.4rem 0 0;
      font-size: 1.75rem;
      font-weight: 800;
      color: rgb(17 24 39);
      position: relative;
      z-index: 1;
    }
    :global(.dark) .speaker-name-hero {
      color: rgb(243 244 246);
    }
    .speaker-role-hero {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
      color: rgb(79 70 229);
      position: relative;
      z-index: 1;
    }
    :global(.dark) .speaker-role-hero {
      color: rgb(165 180 252);
    }
    .speaker-org-hero {
      margin: 0;
      font-size: 0.88rem;
      color: rgb(107 114 128);
      position: relative;
      z-index: 1;
    }
    :global(.dark) .speaker-org-hero {
      color: rgb(156 163 175);
    }
    .speaker-links-hero {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 0.8rem;
      width: 100%;
      position: relative;
      z-index: 1;
    }
    .speaker-pill-link {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.55rem 1rem;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.3);
      background: rgba(248, 250, 252, 0.8);
      color: rgb(55 65 81);
      font-size: 0.9rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .speaker-pill-link svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }
    .speaker-pill-link:hover {
      border-color: rgba(99, 102, 241, 0.5);
      background: rgba(99, 102, 241, 0.08);
      color: rgb(79 70 229);
      transform: translateY(-1px);
    }
    :global(.dark) .speaker-pill-link {
      border-color: rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.05);
      color: rgb(209 213 219);
    }
    :global(.dark) .speaker-pill-link:hover {
      border-color: rgba(129, 140, 248, 0.5);
      background: rgba(99, 102, 241, 0.15);
      color: rgb(199 210 254);
    }

    .code-chip {
      margin-top: 0.25rem;
      width: fit-content;
      border-radius: 0.7rem;
      border: 1px solid rgba(148, 163, 184, 0.4);
      background: rgba(255, 255, 255, 0.7);
      color: rgb(31 41 55);
      padding: 0.45rem 0.7rem;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.88rem;
      font-weight: 700;
      transition: border-color 0.2s ease;
    }
    .code-chip:hover {
      border-color: rgba(99, 102, 241, 0.5);
    }

    /* ── Navigation ── */
    .nav-btn {
      border-radius: 0.7rem;
      border: 1px solid rgba(148, 163, 184, 0.4);
      background: rgba(255, 255, 255, 0.78);
      color: rgb(55 65 81);
      padding: 0.5rem 0.92rem;
      font-size: 0.84rem;
      font-weight: 700;
      transition: all 0.2s ease;
      min-width: 5.4rem;
    }

    .nav-btn:hover {
      transform: translateY(-1px);
    }

    .nav-btn-primary {
      border-color: rgba(14, 116, 144, 0.45);
      background: linear-gradient(
        to right,
        rgb(6, 182, 212),
        rgb(99, 102, 241)
      );
      color: #fff;
    }

    /* ── Slide Dots - Circle Highlight ── */
    .slide-dots {
      display: flex;
      gap: 0.7rem;
      overflow-x: auto;
      overflow-y: visible;
      padding: 0.6rem 0.5rem;
      justify-content: center;
      scrollbar-width: thin;
    }

    :global(.dot-btn) {
      min-width: 2.2rem;
      height: 2.2rem;
      border-radius: 999px;
      border: 2px solid rgba(148, 163, 184, 0.35);
      background: rgba(255, 255, 255, 0.8);
      color: rgb(55 65 81);
      font-size: 0.78rem;
      font-weight: 800;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    :global(.dot-btn:hover) {
      background: rgb(248 250 252);
      border-color: rgba(99, 102, 241, 0.5);
      transform: translateY(-2px);
    }

    :global(.dot-btn.is-active) {
      border-color: transparent;
      background: linear-gradient(135deg, rgb(99, 102, 241), rgb(6, 182, 212));
      color: #fff;
      box-shadow:
        0 0 0 3px rgba(99, 102, 241, 0.45),
        inset 0 0 0 1.5px rgba(255, 255, 255, 0.35),
        0 4px 14px -4px rgba(99, 102, 241, 0.6);
    }

    /* ── Overview Mode ── */
    .deck-wrap.is-overview .slide {
      position: relative;
      inset: auto;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      min-height: auto;
      border-top: 1px solid rgba(148, 163, 184, 0.2);
      padding-top: 1.2rem;
      padding-bottom: 1.2rem;
    }

    .deck-wrap.is-overview .slide:first-of-type {
      border-top: none;
    }

    .deck-wrap.is-overview .slide-title {
      font-size: clamp(1.1rem, 2.1vw, 1.45rem);
      max-width: none;
    }

    .deck-wrap.is-overview .slide-list,
    .deck-wrap.is-overview .slide-text {
      font-size: 0.95rem;
    }

    .deck-wrap.is-overview .slide-dots,
    .deck-wrap.is-overview #progressBar,
    .deck-wrap.is-overview #prevBtn,
    .deck-wrap.is-overview #nextBtn {
      display: none;
    }

    /* ── Dark mode base ── */
    :global(.dark) .slide-title {
      color: rgb(243 244 246);
    }
    :global(.dark) .slide-text {
      color: rgb(209 213 219);
    }
    :global(.dark) .slide-list {
      color: rgb(229 231 235);
    }
    :global(.dark) .slide-tags span {
      border-color: rgba(103, 232, 249, 0.3);
      background: rgba(8, 145, 178, 0.2);
      color: rgb(165 243 252);
    }
    :global(.dark) .speaker-card {
      border-color: rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.05);
    }
    :global(.dark) .speaker-name {
      color: rgb(243 244 246);
    }
    :global(.dark) .speaker-role {
      color: rgb(209 213 219);
    }
    :global(.dark) .code-chip {
      border-color: rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.06);
      color: rgb(243 244 246);
    }
    :global(.dark) .nav-btn {
      border-color: rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.07);
      color: rgb(243 244 246);
    }
    :global(.dark .dot-btn) {
      border-color: rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.06);
      color: rgb(229 231 235);
    }
    :global(.dark .dot-btn.is-active) {
      border-color: transparent;
      background: linear-gradient(135deg, rgb(99, 102, 241), rgb(6, 182, 212));
      color: #fff;
      box-shadow:
        0 0 0 3px rgba(99, 102, 241, 0.55),
        inset 0 0 0 1.5px rgba(255, 255, 255, 0.35),
        0 4px 14px -4px rgba(99, 102, 241, 0.7);
    }

    /* ── Agenda Layout ── */
    .agenda-layout {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      width: 100%;
      flex: 1;
    }
    .agenda-section {
      background: rgba(248, 250, 252, 0.4);
      border: 1px solid rgba(148, 163, 184, 0.15);
      border-radius: 0.9rem;
      padding: 1.1rem;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
      display: flex;
      flex-direction: column;
    }
    .agenda-section:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px -8px rgba(99, 102, 241, 0.08);
    }
    :global(.dark) .agenda-section {
      background: rgba(255, 255, 255, 0.01);
      border-color: rgba(255, 255, 255, 0.05);
    }
    .agenda-header {
      font-size: 1.05rem;
      font-weight: 800;
      color: rgb(14, 116, 144);
      margin-bottom: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    :global(.dark) .agenda-header {
      color: rgb(34, 211, 238);
    }

    /* ═══ AGENT HUB DIAGRAM ═══ */
    .agent-hub-layout {
      display: flex;
      align-items: center;
      gap: 2.5rem;
      width: 100%;
      flex: 1;
    }
    .agent-hub-center {
      position: relative;
      flex-shrink: 0;
      width: 180px;
      height: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .agent-hub-ring {
      position: absolute;
      inset: 0;
      border-radius: 999px;
      border: 2.5px solid rgba(99, 102, 241, 0.45);
      animation: hub-pulse 3s ease-in-out infinite;
    }
    .agent-hub-ring::after {
      content: "";
      position: absolute;
      inset: 8px;
      border-radius: 999px;
      border: 1.5px dashed rgba(6, 182, 212, 0.35);
    }
    @keyframes hub-pulse {
      0%,
      100% {
        box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.25);
      }
      50% {
        box-shadow: 0 0 0 10px rgba(99, 102, 241, 0);
      }
    }
    .agent-hub-core {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      z-index: 1;
      gap: 0.1rem;
    }
    .agent-hub-core strong {
      display: block;
      font-size: 1rem;
      font-weight: 800;
      color: rgb(67 56 202);
      margin-top: 0.2rem;
    }
    :global(.dark) .agent-hub-core strong {
      color: rgb(165 180 252);
    }
    .agent-hub-core span {
      display: block;
      font-size: 0.85rem;
      color: rgb(107 114 128);
    }
    :global(.dark) .agent-hub-core span {
      color: rgb(156 163 175);
    }
    .agent-hub-spokes {
      flex: 1;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.9rem;
    }
    .agent-hub-spoke {
      border: 1px solid rgba(148, 163, 184, 0.25);
      background: rgba(255, 255, 255, 0.65);
      border-radius: 0.85rem;
      padding: 1rem 1.1rem;
      transition: all 0.3s ease;
    }
    .agent-hub-spoke:hover {
      transform: translateY(-3px);
      border-color: rgba(99, 102, 241, 0.35);
      box-shadow: 0 6px 16px -6px rgba(99, 102, 241, 0.12);
    }
    :global(.dark) .agent-hub-spoke {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(255, 255, 255, 0.1);
    }
    .spoke-plan {
      border-color: rgba(99, 102, 241, 0.3);
    }
    .spoke-tool {
      border-color: rgba(6, 182, 212, 0.3);
    }
    .spoke-mem {
      border-color: rgba(16, 185, 129, 0.3);
    }
    .spoke-obs {
      border-color: rgba(139, 92, 246, 0.3);
    }
    .hub-spoke-icon {
      font-size: 2.4rem;
    }
    .agent-hub-spoke strong {
      display: block;
      font-size: 1.35rem;
      font-weight: 800;
      color: rgb(17 24 39);
      margin: 0.35rem 0 0.3rem;
    }
    :global(.dark) .agent-hub-spoke strong {
      color: rgb(243 244 246);
    }
    .agent-hub-spoke p {
      font-size: 1.08rem;
      color: rgb(107 114 128);
      margin: 0;
      line-height: 1.55;
    }
    :global(.dark) .agent-hub-spoke p {
      color: rgb(156 163 175);
    }

    /* ═══ MAF FEATURE GRID ═══ */
    .maf-feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.8rem;
      max-width: 62rem;
      width: 100%;
    }
    .maf-feature-card {
      border: 1px solid rgba(148, 163, 184, 0.25);
      background: rgba(255, 255, 255, 0.65);
      border-radius: 0.9rem;
      padding: 0.8rem;
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      transition: all 0.3s ease;
    }
    .maf-feature-card:hover {
      transform: translateY(-3px);
      border-color: rgba(99, 102, 241, 0.4);
      box-shadow: 0 8px 24px -8px rgba(99, 102, 241, 0.1);
    }
    :global(.dark) .maf-feature-card {
      background: rgba(255, 255, 255, 0.03);
      border-color: rgba(255, 255, 255, 0.1);
    }
    .maf-feature-icon {
      font-size: 1.4rem;
    }
    .maf-feature-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: rgb(17 24 39);
    }
    :global(.dark) .maf-feature-title {
      color: rgb(243 244 246);
    }
    .maf-feature-desc {
      font-size: 0.78rem;
      color: rgb(75 85 99);
      line-height: 1.4;
    }
    :global(.dark) .maf-feature-desc {
      color: rgb(209 213 219);
    }
    .maf-feature-code {
      font-family: "JetBrains Mono", monospace;
      font-size: 0.68rem;
      color: rgb(99 102 241);
      background: rgba(99, 102, 241, 0.06);
      padding: 0.2rem 0.4rem;
      border-radius: 0.4rem;
      margin-top: auto;
      display: block;
      width: fit-content;
    }
    :global(.dark) .maf-feature-code {
      color: rgb(165 180 252);
      background: rgba(99, 102, 241, 0.15);
    }

    /* ═══ MAF Slide Layout ═══ */
    .maf-explanation-layout {
      display: grid;
      grid-template-columns: minmax(320px, 1.7fr) minmax(320px, 1.3fr);
      gap: 1.75rem;
      align-items: stretch;
      max-width: none;
      width: 100%;
      flex: 1;
    }
    .maf-left-col {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 1rem;
    }
    .maf-intro-text {
      font-size: 1.42rem;
      line-height: 1.72;
      color: rgb(55 65 81);
      margin: 0;
    }
    :global(.dark) .maf-intro-text {
      color: rgb(209 213 219);
    }
    .maf-key-list {
      margin: 0;
      padding-left: 1.3rem;
      display: grid;
      gap: 0.85rem;
      list-style: disc inside;
      color: rgb(55 65 81);
      font-size: 1.25rem;
      line-height: 1.72;
    }
    .maf-key-list li {
      margin: 0;
      padding: 0;
    }
    :global(.dark) .maf-key-list {
      color: rgb(209 213 219);
    }
    .maf-key-list code {
      font-size: 1rem;
      color: rgb(99 102 241);
    }
    :global(.dark) .maf-key-list code {
      color: rgb(165 180 252);
    }
    .maf-feature-grid-two {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(180px, auto);
      gap: 1rem;
      height: 100%;
      align-items: stretch;
    }
    .maf-feature-card-compact {
      border: 1px solid rgba(148, 163, 184, 0.22);
      background: rgba(255, 255, 255, 0.72);
      border-radius: 0.85rem;
      padding: 1.15rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      transition: all 0.3s ease;
    }
    .maf-card-title {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 1.4rem;
      font-weight: 800;
      color: rgb(67 56 202);
    }
    :global(.dark) .maf-card-title {
      color: rgb(103 232 249);
    }
    .maf-card-desc {
      font-size: 1.18rem;
      line-height: 1.75;
      color: rgb(107 114 128);
      margin: 0;
    }
    :global(.dark) .maf-card-desc {
      color: rgb(156 163 175);
    }
    .maf-card-desc code {
      font-size: 1.1rem;
      color: rgb(99 102 241);
    }
    :global(.dark) .maf-card-desc code {
      color: rgb(165 180 252);
    }
    .maf-feature-card-compact:hover {
      transform: translateY(-2px);
      border-color: rgba(99, 102, 241, 0.35);
      box-shadow: 0 4px 12px -4px rgba(99, 102, 241, 0.15);
    }
    :global(.dark) .maf-feature-card-compact {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(255, 255, 255, 0.1);
    }

    /* ═══ MEMORY FLOW DIAGRAM ═══ */
    .memory-flow-diagram {
      display: flex;
      align-items: stretch;
      justify-content: center;
      gap: 0.7rem;
      width: 100%;
      max-width: 100%;
      background: rgba(248, 250, 252, 0.55);
      border: 1px dashed rgba(99, 102, 241, 0.25);
      border-radius: 1.1rem;
      padding: 1.1rem;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5);
      overflow: hidden;
    }
    :global(.dark) .memory-flow-diagram {
      background: rgba(15, 17, 23, 0.45);
      border-color: rgba(99, 102, 241, 0.35);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    }
    .mflow-node {
      --mflow-accent: transparent;
      flex: 1 1 0;
      min-width: 0;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.55rem;
      background: rgba(255, 255, 255, 0.92);
      border: 1.5px solid rgba(148, 163, 184, 0.24);
      border-radius: 1rem;
      padding: 1rem 0.9rem;
      transition: all 0.25s ease;
      min-height: 11rem;
      justify-content: center;
      box-sizing: border-box;
      box-shadow: inset 4px 0 0 var(--mflow-accent);
    }
    :global(.dark) .mflow-node {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.12);
    }
    .mflow-node:hover {
      transform: translateY(-3px);
      box-shadow:
        inset 4px 0 0 var(--mflow-accent),
        0 18px 40px -22px rgba(99, 102, 241, 0.28);
    }
    .mflow-node-session {
      --mflow-accent: rgb(99, 102, 241);
    }
    .mflow-node-context {
      --mflow-accent: rgb(6, 182, 212);
    }
    .mflow-node-db {
      --mflow-accent: rgb(16, 185, 129);
    }
    .mflow-icon {
      font-size: 2rem;
      line-height: 1;
    }
    .mflow-node strong {
      font-size: 1.1rem;
      color: rgb(17 24 39);
      letter-spacing: 0.01em;
    }
    :global(.dark) .mflow-node strong {
      color: rgb(243 244 246);
    }
    .mflow-node span {
      font-size: 0.95rem;
      color: rgb(75 85 99);
      line-height: 1.55;
      max-width: 100%;
    }
    :global(.dark) .mflow-node span {
      color: rgb(209 213 219);
    }
    .mflow-arrow {
      font-size: 1.5rem;
      color: rgb(79 70 229);
      flex: 0 0 auto;
    }
    @media (max-width: 920px) {
      .memory-flow-diagram {
        flex-wrap: wrap;
        justify-content: center;
      }
      .mflow-node {
        flex: 1 1 100%;
        min-width: auto;
      }
      .mflow-arrow {
        transform: rotate(90deg);
      }
    }

    /* ═══ LOOP DIAGRAM ═══ */
    .loop-diagram {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      width: 100%;
      flex-wrap: wrap;
    }
    .loop-node {
      flex: 0 0 auto;
      width: clamp(180px, 21vw, 260px);
      background: rgba(255, 255, 255, 0.7);
      border: 2px solid rgba(148, 163, 184, 0.3);
      border-radius: 1.1rem;
      padding: 1rem 0.85rem;
      text-align: center;
      position: relative;
      transition: all 0.3s ease;
    }
    .loop-node:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px -8px rgba(99, 102, 241, 0.15);
    }
    :global(.dark) .loop-node {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(255, 255, 255, 0.12);
    }
    .loop-node-num {
      position: absolute;
      top: -8px;
      left: -8px;
      width: 24px;
      height: 24px;
      border-radius: 999px;
      background: linear-gradient(135deg, rgb(99, 102, 241), rgb(6, 182, 212));
      color: #fff;
      font-size: 0.7rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .loop-node-icon {
      font-size: 1.4rem;
    }
    .loop-node-label {
      font-size: 0.95rem;
      font-weight: 800;
      color: rgb(17 24 39);
    }
    :global(.dark) .loop-node-label {
      color: rgb(243 244 246);
    }
    .loop-node-desc {
      font-size: 0.68rem;
      color: rgb(107 114 128);
      line-height: 1.3;
      margin-top: 0.35rem;
    }
    :global(.dark) .loop-node-desc {
      color: rgb(156 163 175);
    }
    .loop-think {
      border-color: rgba(99, 102, 241, 0.4);
    }
    .loop-act {
      border-color: rgba(6, 182, 212, 0.4);
    }
    .loop-observe {
      border-color: rgba(16, 185, 129, 0.4);
    }
    .loop-respond {
      border-color: rgba(139, 92, 246, 0.4);
    }
    .loop-connector {
      width: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .loop-arrow-svg {
      width: 52px;
      height: 20px;
    }
    .loop-return-arrow {
      position: relative;
      margin-top: -0.2rem;
      text-align: center;
    }
    .loop-return-label {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 0.72rem;
      font-weight: 700;
      color: rgba(139, 92, 246, 0.6);
      white-space: nowrap;
    }

    /* ═══ TOOL CALL FLOW ═══ */
    .tc-flow {
      display: flex;
      align-items: stretch;
      gap: 0.35rem;
      width: 100%;
      max-width: 100%;
      flex: 1;
      flex-wrap: nowrap;
      justify-content: center;
      overflow-x: auto;
      padding-bottom: 0.35rem;
    }
    .tc-flow::-webkit-scrollbar {
      height: 8px;
    }
    .tc-flow::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.4);
      border-radius: 999px;
    }
    .tc-step {
      flex: 0 0 auto;
      min-width: 150px;
      max-width: 220px;
      background: rgba(255, 255, 255, 0.7);
      border: 1.5px solid rgba(148, 163, 184, 0.3);
      border-radius: 0.85rem;
      padding: 1.05rem 0.75rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.45rem;
      transition: all 0.3s ease;
    }
    .tc-step:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 20px -6px rgba(99, 102, 241, 0.12);
    }
    :global(.dark) .tc-step {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(255, 255, 255, 0.1);
    }
    .tc-step-user {
      border-color: rgba(148, 163, 184, 0.4);
    }
    .tc-step-agent {
      border-color: rgba(99, 102, 241, 0.4);
      background: rgba(99, 102, 241, 0.05);
    }
    .tc-step-llm {
      border-color: rgba(139, 92, 246, 0.4);
      background: rgba(139, 92, 246, 0.05);
    }
    .tc-step-tool {
      border-color: rgba(16, 185, 129, 0.4);
      background: rgba(16, 185, 129, 0.05);
    }
    .tc-step-output {
      border-color: rgba(6, 182, 212, 0.4);
      background: rgba(6, 182, 212, 0.05);
    }
    :global(.dark) .tc-step-agent {
      background: rgba(99, 102, 241, 0.1);
      border-color: rgba(99, 102, 241, 0.3);
    }
    :global(.dark) .tc-step-llm {
      background: rgba(139, 92, 246, 0.1);
      border-color: rgba(139, 92, 246, 0.3);
    }
    :global(.dark) .tc-step-tool {
      background: rgba(16, 185, 129, 0.1);
      border-color: rgba(16, 185, 129, 0.3);
    }
    :global(.dark) .tc-step-output {
      background: rgba(6, 182, 212, 0.1);
      border-color: rgba(6, 182, 212, 0.3);
    }
    .tc-icon {
      font-size: 1.6rem;
    }
    .tc-label {
      font-size: 0.85rem;
      font-weight: 800;
      color: rgb(17 24 39);
    }
    :global(.dark) .tc-label {
      color: rgb(243 244 246);
    }
    .tc-sub {
      font-size: 0.67rem;
      color: rgb(107 114 128);
      line-height: 1.3;
    }
    .tc-sub code {
      font-size: 0.65rem;
      color: rgb(99 102 241);
      font-family: "JetBrains Mono", monospace;
    }
    :global(.dark) .tc-sub {
      color: rgb(156 163 175);
    }
    :global(.dark) .tc-sub code {
      color: rgb(165 180 252);
    }
    .tc-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 0.35rem;
      font-size: 1.4rem;
      color: rgba(99, 102, 241, 0.5);
      flex-shrink: 0;
    }
    :global(.dark) .tc-arrow {
      color: rgba(165, 180, 252, 0.6);
    }

    /* ═══ MCP DIAGRAM ═══ */
    .mcp-diagram {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 1.25rem;
      align-items: center;
      max-width: none;
      width: 100%;
    }
    .mcp-col {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .mcp-box {
      border: 2px solid rgba(148, 163, 184, 0.3);
      background: rgba(255, 255, 255, 0.75);
      border-radius: 1rem;
      padding: 1.15rem;
      text-align: center;
      transition: all 0.3s ease;
    }
    .mcp-box:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px -6px rgba(99, 102, 241, 0.12);
    }
    :global(.dark) .mcp-box {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(255, 255, 255, 0.12);
    }
    .mcp-host {
      border-color: rgba(99, 102, 241, 0.4);
    }
    .mcp-server {
      border-color: rgba(16, 185, 129, 0.4);
    }
    .mcp-server-2 {
      border-color: rgba(245, 158, 11, 0.4);
    }
    .mcp-box-icon {
      font-size: 2rem;
    }
    .mcp-box-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: rgb(17 24 39);
    }
    :global(.dark) .mcp-box-title {
      color: rgb(243 244 246);
    }
    .mcp-box-desc {
      font-size: 0.85rem;
      color: rgb(107 114 128);
      margin-top: 0.3rem;
    }
    :global(.dark) .mcp-box-desc {
      color: rgb(156 163 175);
    }
    .mcp-col-center {
      align-items: center;
    }
    .mcp-bridge {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.45rem;
    }
    .mcp-bridge-line {
      width: 3px;
      height: 24px;
      background: linear-gradient(
        to bottom,
        rgba(99, 102, 241, 0.3),
        rgba(6, 182, 212, 0.3)
      );
      border-radius: 2px;
    }
    .mcp-bridge-label {
      text-align: center;
      font-size: 1.25rem;
      font-weight: 800;
      color: rgb(99 102 241);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      line-height: 1.25;
    }
    :global(.dark) .mcp-bridge-label {
      color: rgb(165 180 252);
    }
    .mcp-bridge-icon {
      font-size: 1.7rem;
    }
    .mcp-capabilities {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      align-items: center;
      margin-top: 0.75rem;
    }
    .mcp-cap {
      font-size: 1.15rem;
      font-weight: 800;
      background: rgba(99, 102, 241, 0.15);
      color: rgb(67 56 202);
      padding: 0.45rem 1.1rem;
      border-radius: 999px;
      white-space: nowrap;
    }
    :global(.dark) .mcp-cap {
      background: rgba(99, 102, 241, 0.2);
      color: rgb(199 210 254);
    }

    /* ═══ MEMORY COMPARE ═══ */
    .memory-compare {
      display: flex;
      align-items: stretch;
      gap: 1.25rem;
      max-width: none;
      width: 100%;
    }
    .memory-card {
      flex: 1;
      border: 2px solid rgba(148, 163, 184, 0.3);
      background: rgba(255, 255, 255, 0.7);
      border-radius: 1rem;
      padding: 1.15rem;
      transition: all 0.3s ease;
    }
    .memory-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px -6px rgba(99, 102, 241, 0.1);
    }
    :global(.dark) .memory-card {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(255, 255, 255, 0.1);
    }
    .memory-session {
      border-color: rgba(99, 102, 241, 0.35);
    }
    .memory-persistent {
      border-color: rgba(6, 182, 212, 0.35);
    }
    .memory-card-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }
    .memory-card-header h4 {
      font-size: 1rem;
      font-weight: 800;
      color: rgb(17 24 39);
      margin: 0;
    }
    :global(.dark) .memory-card-header h4 {
      color: rgb(243 244 246);
    }
    .memory-icon {
      font-size: 1.3rem;
    }
    .memory-list {
      margin: 0;
      padding-left: 1rem;
      list-style: disc;
      font-size: 0.82rem;
      color: rgb(75 85 99);
      line-height: 1.6;
    }
    :global(.dark) .memory-list {
      color: rgb(209 213 219);
    }
    .memory-lifetime {
      margin-top: 0.6rem;
      font-size: 0.75rem;
      font-weight: 700;
      color: rgb(99 102 241);
      text-align: center;
      padding: 0.3rem;
      background: rgba(99, 102, 241, 0.06);
      border-radius: 0.5rem;
    }
    :global(.dark) .memory-lifetime {
      color: rgb(165 180 252);
      background: rgba(99, 102, 241, 0.15);
    }
    .memory-vs {
      font-size: 1.2rem;
      font-weight: 900;
      color: rgb(148 163 184);
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    /* ═══ WORKFLOW PIPELINE ═══ */
    .workflow-pipeline {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      flex-wrap: wrap;
    }
    .wf-node {
      flex: 0 0 auto;
      width: clamp(180px, 21vw, 260px);
      background: rgba(255, 255, 255, 0.7);
      border: 2px solid rgba(148, 163, 184, 0.3);
      border-radius: 1rem;
      padding: 1rem 0.9rem;
      text-align: center;
      transition: all 0.3s ease;
    }
    .wf-node:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 24px -6px rgba(99, 102, 241, 0.12);
    }
    :global(.dark) .wf-node {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(255, 255, 255, 0.12);
    }
    .wf-triage {
      border-color: rgba(244, 63, 94, 0.4);
    }
    .wf-agent {
      border-color: rgba(99, 102, 241, 0.4);
    }
    .wf-capture {
      border-color: rgba(16, 185, 129, 0.4);
    }
    .wf-node-icon {
      font-size: 1.4rem;
    }
    .wf-node-title {
      font-size: 0.9rem;
      font-weight: 800;
      color: rgb(17 24 39);
    }
    :global(.dark) .wf-node-title {
      color: rgb(243 244 246);
    }
    .wf-node-type {
      font-size: 0.65rem;
      font-weight: 700;
      color: rgb(99 102 241);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    :global(.dark) .wf-node-type {
      color: rgb(165 180 252);
    }
    .wf-node-desc {
      font-size: 0.7rem;
      color: rgb(107 114 128);
      margin-top: 0.2rem;
    }
    :global(.dark) .wf-node-desc {
      color: rgb(156 163 175);
    }
    .wf-edge {
      width: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .wf-edge svg {
      width: 50px;
      height: 16px;
    }

    /* ═══ OPS CAPABILITIES ═══ */
    .ops-capabilities {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      max-width: none;
      width: 100%;
    }
    .ops-cap-card {
      border: 1px solid rgba(148, 163, 184, 0.25);
      background: rgba(255, 255, 255, 0.65);
      border-radius: 0.9rem;
      padding: 1.1rem;
      text-align: center;
      transition: all 0.3s ease;
    }
    .ops-cap-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 24px -6px rgba(99, 102, 241, 0.1);
    }
    :global(.dark) .ops-cap-card {
      background: rgba(255, 255, 255, 0.03);
      border-color: rgba(255, 255, 255, 0.1);
    }
    .ops-cap-icon {
      font-size: 1.6rem;
    }
    .ops-cap-card h4 {
      font-size: 0.9rem;
      font-weight: 800;
      color: rgb(17 24 39);
      margin: 0.3rem 0 0.15rem;
    }
    :global(.dark) .ops-cap-card h4 {
      color: rgb(243 244 246);
    }
    .ops-cap-card p {
      font-size: 0.72rem;
      color: rgb(107 114 128);
      margin: 0;
      line-height: 1.3;
    }
    :global(.dark) .ops-cap-card p {
      color: rgb(156 163 175);
    }

    /* ═══ MODULE TRACK ═══ */
    .module-track {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      max-width: none;
      width: 100%;
    }
    .module-card {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      border: 1px solid rgba(148, 163, 184, 0.25);
      background: rgba(255, 255, 255, 0.65);
      border-radius: 0.85rem;
      padding: 0.9rem 1.1rem;
      transition: all 0.3s ease;
    }
    .module-card:hover {
      transform: translateX(6px);
      border-color: rgba(99, 102, 241, 0.35);
      box-shadow: 0 4px 16px -4px rgba(99, 102, 241, 0.08);
    }
    :global(.dark) .module-card {
      background: rgba(255, 255, 255, 0.03);
      border-color: rgba(255, 255, 255, 0.08);
    }
    .module-num {
      min-width: 2.4rem;
      height: 2.4rem;
      border-radius: 0.6rem;
      background: linear-gradient(135deg, rgb(99, 102, 241), rgb(6, 182, 212));
      color: #fff;
      font-size: 0.8rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .module-info strong {
      display: block;
      font-size: 0.92rem;
      color: rgb(17 24 39);
    }
    :global(.dark) .module-info strong {
      color: rgb(243 244 246);
    }
    .module-info span {
      font-size: 0.78rem;
      color: rgb(107 114 128);
    }
    :global(.dark) .module-info span {
      color: rgb(156 163 175);
    }

    /* ═══ ARCHITECTURE STACK ═══ */
    .arch-stack {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
      max-width: none;
      width: 100%;
    }
    .arch-layer {
      width: 100%;
      border: 2px solid rgba(99, 102, 241, 0.25);
      background: rgba(99, 102, 241, 0.04);
      border-radius: 0.8rem;
      padding: 0.95rem 1.15rem;
      text-align: center;
      position: relative;
      transition: all 0.3s ease;
    }
    .arch-layer:hover {
      transform: scale(1.02);
      box-shadow: 0 6px 20px -6px rgba(99, 102, 241, 0.1);
    }
    :global(.dark) .arch-layer {
      background: rgba(99, 102, 241, 0.08);
      border-color: rgba(99, 102, 241, 0.2);
    }
    .arch-layer strong {
      display: block;
      font-size: 0.9rem;
      color: rgb(67 56 202);
    }
    :global(.dark) .arch-layer strong {
      color: rgb(165 180 252);
    }
    .arch-layer span {
      font-size: 0.72rem;
      color: rgb(107 114 128);
    }
    :global(.dark) .arch-layer span {
      color: rgb(156 163 175);
    }
    .arch-layer-badge {
      position: absolute;
      top: -8px;
      left: 12px;
      font-size: 0.55rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: linear-gradient(135deg, rgb(99, 102, 241), rgb(6, 182, 212));
      color: #fff;
      padding: 0.1rem 0.4rem;
      border-radius: 999px;
    }
    .arch-layer-connector {
      width: 3px;
      height: 10px;
      background: linear-gradient(
        to bottom,
        rgba(99, 102, 241, 0.3),
        rgba(6, 182, 212, 0.3)
      );
      border-radius: 2px;
    }
    .arch-layer-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
      width: 100%;
    }
    .arch-layer-4 {
      border-color: rgba(6, 182, 212, 0.3);
      background: rgba(6, 182, 212, 0.04);
    }
    :global(.dark) .arch-layer-4 {
      border-color: rgba(6, 182, 212, 0.2);
      background: rgba(6, 182, 212, 0.08);
    }
    .arch-layer-4 strong {
      color: rgb(14 116 144);
    }
    :global(.dark) .arch-layer-4 strong {
      color: rgb(103 232 249);
    }
    .arch-layer-5 {
      border-color: rgba(6, 182, 212, 0.3);
      background: rgba(6, 182, 212, 0.04);
    }
    :global(.dark) .arch-layer-5 {
      border-color: rgba(6, 182, 212, 0.2);
      background: rgba(6, 182, 212, 0.08);
    }
    .arch-layer-5 strong {
      color: rgb(14 116 144);
    }
    :global(.dark) .arch-layer-5 strong {
      color: rgb(103 232 249);
    }
    .arch-layer-6 {
      border-color: rgba(245, 158, 11, 0.3);
      background: rgba(245, 158, 11, 0.04);
    }
    :global(.dark) .arch-layer-6 {
      border-color: rgba(245, 158, 11, 0.2);
      background: rgba(245, 158, 11, 0.08);
    }
    .arch-layer-6 strong {
      color: rgb(180 83 9);
    }
    :global(.dark) .arch-layer-6 strong {
      color: rgb(252 211 77);
    }

    /* ═══ TIMELINE FLOW ═══ */
    .timeline-flow {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 0.7rem;
      max-width: none;
      width: 100%;
      position: relative;
      padding-top: 2rem;
    }
    @media (min-width: 921px) {
      .timeline-flow::before {
        content: "";
        position: absolute;
        top: 0.75rem;
        left: 5%;
        right: 5%;
        height: 3px;
        background: linear-gradient(
          to right,
          rgb(99, 102, 241),
          rgb(6, 182, 212),
          rgb(16, 185, 129),
          rgb(139, 92, 246),
          rgb(244, 63, 94),
          rgb(245, 158, 11)
        );
        z-index: 0;
        border-radius: 99px;
        opacity: 0.55;
      }
    }
    .timeline-block {
      border: 2px solid rgba(148, 163, 184, 0.25);
      background: rgba(255, 255, 255, 0.8);
      border-radius: 0.9rem;
      padding: 1rem 0.7rem;
      text-align: center;
      transition: all 0.3s ease;
      position: relative;
