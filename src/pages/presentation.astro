      .speaker-card {
        width: 100%;
      }
      .slide-dots {
        justify-content: flex-start;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const slides = Array.from(document.querySelectorAll(".slide"));
      const nextBtn = document.getElementById("nextBtn");
      const prevBtn = document.getElementById("prevBtn");
      const label = document.getElementById("slideLabel");
      const title = document.getElementById("slideTitle");
      const progressBar = document.getElementById("progressBar");
      const overviewBtn = document.getElementById("overviewBtn");
      const fullscreenBtn = document.getElementById("fullscreenBtn");
      const deck = document.querySelector(".deck-wrap");
      const dotsWrap = document.getElementById("slideDots");
      const canvas = document.getElementById("mouseCanvas");

      if (
        !slides.length ||
        !nextBtn ||
        !prevBtn ||
        !label ||
        !title ||
        !progressBar ||
        !overviewBtn ||
        !fullscreenBtn ||
        !deck ||
        !dotsWrap ||
        !canvas
      ) {
        return;
      }

      let current = 0;
      let overview = false;
      let touchStartX = 0;

      // ── Quantum Nexus Aura & Interactive Sparks Mouse Tracker ──
      const ctx = canvas.getContext("2d");
      let sparks = [];
      let ripples = [];
      let mouseX = -500,
        mouseY = -500;
      let targetMouseX = -500,
        targetMouseY = -500;
      let lastMoveTime = 0;
      let animFrame = null;

      const resizeCanvas = () => {
        const rect = deck.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
      };

      class Spark {
        constructor(x, y) {
          this.x = x;
          this.y = y;
          const angle = Math.random() * Math.PI * 2;
          const speed = Math.random() * 2 + 0.5;
          this.vx = Math.cos(angle) * speed;
          this.vy = Math.sin(angle) * speed;
          this.size = Math.random() * 2.5 + 1.2;
          this.alpha = 1;
          this.decay = Math.random() * 0.015 + 0.01;
          // Cycled color hue: 180 (cyan) to 270 (purple)
          this.hue = Math.floor(Math.random() * 90) + 180;
        }
        update() {
          this.x += this.vx;
          this.y += this.vy;
          this.vx *= 0.97;
          this.vy *= 0.97;
          this.alpha -= this.decay;
        }
        draw() {
          if (this.alpha <= 0) return;
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
          ctx.fillStyle = `hsla(${this.hue}, 90%, 65%, ${this.alpha})`;
          ctx.fill();
        }
      }

      class Ripple {
        constructor(x, y) {
          this.x = x;
          this.y = y;
          this.radius = 0;
          this.maxRadius = 150;
          this.alpha = 1;
          this.speed = 4;
        }
        update() {
          this.radius += this.speed;
          this.alpha = 1 - this.radius / this.maxRadius;
        }
        draw() {
          if (this.alpha <= 0) return;
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(99, 102, 241, ${this.alpha * 0.35})`;
          ctx.lineWidth = 2.5;
          ctx.stroke();
        }
      }

      const animate = () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Interpolate mouse coordinates (smooth spring delay)
        if (targetMouseX > -100) {
          if (mouseX < 0) {
            mouseX = targetMouseX;
            mouseY = targetMouseY;
          } else {
            mouseX += (targetMouseX - mouseX) * 0.12;
            mouseY += (targetMouseY - mouseY) * 0.12;
          }

          // Draw the soft interactive glowing aura (radial gradient)
          const glow = ctx.createRadialGradient(
            mouseX,
            mouseY,
            5,
            mouseX,
            mouseY,
            95,
          );
          glow.addColorStop(0, "rgba(99, 102, 241, 0.18)");
          glow.addColorStop(0.5, "rgba(6, 182, 212, 0.06)");
          glow.addColorStop(1, "rgba(0, 0, 0, 0)");
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(mouseX, mouseY, 95, 0, Math.PI * 2);
          ctx.fill();
        } else {
          // Fade mouse out off-screen
          mouseX = -500;
          mouseY = -500;
        }

        // Update and draw sparks
        sparks = sparks.filter((s) => s.alpha > 0);
        sparks.forEach((s) => {
          s.update();
          s.draw();
        });

        // Update and draw ripples
        ripples = ripples.filter((r) => r.alpha > 0);
        ripples.forEach((r) => {
          r.update();
          r.draw();

          // Push sparks outward from ripple
          sparks.forEach((s) => {
            const dx = s.x - r.x;
            const dy = s.y - r.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist > 0 && Math.abs(dist - r.radius) < 15) {
              const pushForce = (1 - dist / r.maxRadius) * 0.8;
              s.vx += (dx / dist) * pushForce;
              s.vy += (dy / dist) * pushForce;
            }
          });
        });

        animFrame = requestAnimationFrame(animate);
      };

      resizeCanvas();
      animate();
      window.addEventListener("resize", () => {
        resizeCanvas();
      });

      deck.addEventListener("mousemove", (e) => {
        const rect = deck.getBoundingClientRect();
        targetMouseX = e.clientX - rect.left;
        targetMouseY = e.clientY - rect.top;

        // Spawn spark particles on movement
        const now = performance.now();
        if (now - lastMoveTime > 20) {
          // Limit spawn rate
          sparks.push(new Spark(targetMouseX, targetMouseY));
          if (sparks.length > 80) sparks.shift();
          lastMoveTime = now;
        }
      });

      deck.addEventListener("mouseleave", () => {
        targetMouseX = -500;
        targetMouseY = -500;
      });

      deck.addEventListener("click", (e) => {
        const rect = deck.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const clickY = e.clientY - rect.top;
        ripples.push(new Ripple(clickX, clickY));

        // Spawn a burst of sparks on click
        for (let i = 0; i < 15; i++) {
          sparks.push(new Spark(clickX, clickY));
        }
      });

      // ── Slide Dots ──
      const dots = slides.map((_, idx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "dot-btn";
        btn.textContent = String(idx + 1);
        btn.setAttribute("aria-label", `Go to slide ${idx + 1}`);
        btn.addEventListener("click", () => go(idx));
        dotsWrap.appendChild(btn);
        return btn;
      });

      const updateFullscreenButton = () => {
        const active = Boolean(document.fullscreenElement);
        fullscreenBtn.setAttribute("aria-pressed", String(active));
        fullscreenBtn.textContent = active ? "Exit Fullscreen" : "Fullscreen";
      };

      const render = () => {
        slides.forEach((slide, idx) => {
          slide.classList.toggle("is-active", idx === current);
        });

        dots.forEach((dot, idx) => {
          dot.classList.toggle("is-active", idx === current);
        });

        const currentSlide = slides[current];
        label.textContent = `${current + 1} / ${slides.length}`;
        title.textContent = currentSlide.dataset.title || "";
        progressBar.style.width = `${((current + 1) / slides.length) * 100}%`;

        // Smooth scroll the dot list without shifting the outer page
        const activeDot = dots[current];
        if (activeDot && dotsWrap) {
          const containerRect = dotsWrap.getBoundingClientRect();
          const dotRect = activeDot.getBoundingClientRect();
          const scrollLeft =
            dotsWrap.scrollLeft +
            (dotRect.left - containerRect.left) -
            containerRect.width / 2 +
            dotRect.width / 2;
          dotsWrap.scrollTo({ left: scrollLeft, behavior: "smooth" });
        }
      };

      const go = (idx) => {
        if (overview) return;
        current = Math.max(0, Math.min(slides.length - 1, idx));
        render();
      };

      const setOverview = (value) => {
        overview = value;
        deck.classList.toggle("is-overview", overview);
        overviewBtn.setAttribute("aria-pressed", String(overview));
        overviewBtn.textContent = overview ? "Exit Overview" : "Overview";
      };

      const toggleFullscreen = async () => {
        try {
          if (!document.fullscreenElement) {
            await deck.requestFullscreen();
          } else {
            await document.exitFullscreen();
          }
        } catch {
          // Ignore fullscreen errors
        }
        updateFullscreenButton();
        // Resize canvas after fullscreen change
        setTimeout(() => {
          resizeCanvas();
        }, 300);
      };

      nextBtn.addEventListener("click", () => go(current + 1));
      prevBtn.addEventListener("click", () => go(current - 1));
      overviewBtn.addEventListener("click", () => setOverview(!overview));
      fullscreenBtn.addEventListener("click", toggleFullscreen);

      document.addEventListener("fullscreenchange", () => {
        updateFullscreenButton();
        setTimeout(() => {
          resizeCanvas();
        }, 300);
      });

      window.addEventListener("keydown", (event) => {
        if (
          ["INPUT", "TEXTAREA", "SELECT"].includes(
            document.activeElement?.tagName || "",
          )
        )
          return;

        if (
          event.key === "ArrowRight" ||
          event.key === "PageDown" ||
          event.key === " "
        ) {
          event.preventDefault();
          go(current + 1);
        } else if (event.key === "ArrowLeft" || event.key === "PageUp") {
          event.preventDefault();
          go(current - 1);
        } else if (event.key === "Home") {
          event.preventDefault();
          go(0);
        } else if (event.key === "End") {
          event.preventDefault();
          go(slides.length - 1);
        } else if (event.key.toLowerCase() === "o") {
          event.preventDefault();
          setOverview(!overview);
        } else if (event.key.toLowerCase() === "f") {
          event.preventDefault();
          toggleFullscreen();
        }
      });

      deck.addEventListener(
        "touchstart",
        (event) => {
          touchStartX = event.changedTouches[0]?.clientX || 0;
        },
        { passive: true },
      );

      deck.addEventListener(
        "touchend",
        (event) => {
          const touchEndX = event.changedTouches[0]?.clientX || 0;
          const delta = touchEndX - touchStartX;
          if (Math.abs(delta) < 45 || overview) return;
          if (delta < 0) go(current + 1);
          else go(current - 1);
        },
        { passive: true },
      );

      updateFullscreenButton();
      render();
    })();
  </script>
</BaseLayout>
