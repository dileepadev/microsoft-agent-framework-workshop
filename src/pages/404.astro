---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for does not exist in the Microsoft Agent Framework Workshop site."
>
  <section
    class="relative min-h-[78vh] flex items-center justify-center px-4 overflow-hidden"
  >
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div
        class="absolute inset-0 bg-[linear-gradient(rgba(79,70,229,0.06)_1px,transparent_1px),linear-gradient(90deg,rgba(79,70,229,0.06)_1px,transparent_1px)] [background-size:34px_34px]"
      >
      </div>
      <div
        class="absolute -top-16 -left-16 w-80 h-80 bg-primary-500/20 blur-3xl rounded-full animate-pulse-slow"
      >
      </div>
      <div
        class="absolute -bottom-20 -right-20 w-96 h-96 bg-violet-500/20 blur-3xl rounded-full animate-pulse-slow"
        style="animation-delay:2s"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-3xl w-full text-center">
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full mb-6 text-xs font-semibold tracking-wide uppercase bg-primary-50 dark:bg-primary-500/10 text-primary-700 dark:text-primary-300 border border-primary-200 dark:border-primary-500/30"
      >
        Route Not Found
      </div>

      <h1
        class="text-7xl sm:text-8xl font-black leading-none tracking-tight mb-4 gradient-text"
      >
        404
      </h1>
      <h2
        class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-4"
      >
        This page drifted out of the workflow.
      </h2>
      <p
        class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-9 text-lg leading-relaxed"
      >
        The link may be outdated, or the page moved during a workshop update.
        Use one of the quick paths below to continue.
      </p>

      <div class="flex flex-wrap justify-center gap-3 sm:gap-4 mb-8">
        <a
          href="./"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm sm:text-base font-semibold text-white bg-gradient-to-r from-primary-500 to-violet-600 hover:from-primary-600 hover:to-violet-700 transition-all duration-200 hover:-translate-y-0.5 shadow-lg shadow-primary-500/25"
        >
          Go Home
        </a>

        <a
          href="getting-started/1-environment-setup"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm sm:text-base font-semibold border border-gray-300 dark:border-white/15 text-gray-800 dark:text-gray-100 bg-white/80 dark:bg-white/[0.04] hover:bg-white dark:hover:bg-white/[0.08] transition-all duration-200 hover:-translate-y-0.5"
        >
          Start Module 1
        </a>

        <a
          href="introduction"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm sm:text-base font-semibold border border-gray-300 dark:border-white/15 text-gray-700 dark:text-gray-200 hover:text-gray-900 dark:hover:text-white transition-colors"
        >
          Read Introduction
        </a>
      </div>

      <div
        class="mx-auto max-w-2xl text-left bg-white/75 dark:bg-white/[0.03] border border-gray-200 dark:border-white/[0.08] rounded-2xl p-5 sm:p-6 backdrop-blur-sm"
      >
        <p class="text-sm font-semibold text-gray-700 dark:text-gray-200 mb-3">
          Popular workshop routes
        </p>
        <ul class="grid sm:grid-cols-2 gap-2 text-sm">
          <li>
            <a
              class="text-primary-600 dark:text-primary-400 hover:underline"
              href="getting-started/4-tool-calling">Module 4: Tool Calling</a
            >
          </li>
          <li>
            <a
              class="text-primary-600 dark:text-primary-400 hover:underline"
              href="getting-started/5-mcp-integration"
              >Module 5: MCP Integration</a
            >
          </li>
          <li>
            <a
              class="text-primary-600 dark:text-primary-400 hover:underline"
              href="getting-started/8-workflows">Module 8: Workflows</a
            >
          </li>
          <li>
            <a
              class="text-primary-600 dark:text-primary-400 hover:underline"
              href="getting-started/10-host-agent">Module 10: Host Agent</a
            >
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
