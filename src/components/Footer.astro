---
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200/80 dark:border-white/[0.06]">
  <div
    class="max-w-screen-2xl mx-auto px-4 sm:px-6 py-8
           flex flex-col sm:flex-row items-center justify-between gap-4"
  >
    <div
      class="flex items-center gap-2.5 text-sm text-gray-500 dark:text-gray-400"
    >
      <div
        class="w-6 h-6 rounded-md bg-gradient-to-br from-primary-500 to-violet-600 flex items-center justify-center text-white text-[0.6rem] font-black"
      >
        MAF
      </div>
      <span>Microsoft Agent Framework Workshop &copy; {year}</span>
    </div>

    <div
      class="flex items-center gap-6 text-sm text-gray-500 dark:text-gray-400"
    >
      <a
        href="https://github.com/dileepadev/microsoft-agent-framework-workshop"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-gray-900 dark:hover:text-white transition-colors duration-150"
        >GitHub</a
      >
      <a
        href="https://aka.ms/agentframework"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-gray-900 dark:hover:text-white transition-colors duration-150"
        >Agent Framework Docs</a
      >
      <a
        href={`${base}/introduction`}
        class="hover:text-gray-900 dark:hover:text-white transition-colors duration-150"
        >Introduction</a
      >
    </div>
  </div>
</footer>
