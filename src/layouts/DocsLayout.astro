---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import { flatNav } from "../data/nav";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: Record<string, string>;
}

const { frontmatter = {} } = Astro.props;
const title = frontmatter.title ?? Astro.props.title;
const description = frontmatter.description ?? Astro.props.description;

// Prev / next page navigation
const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
const currentPath = Astro.url.pathname;

const currentIdx = flatNav.findIndex((item) => {
  const full = `${base}${item.href}`;
  return currentPath === full || currentPath === full + "/";
});

const prev = currentIdx > 0 ? flatNav[currentIdx - 1] : null;
const next = currentIdx < flatNav.length - 1 ? flatNav[currentIdx + 1] : null;
---

<BaseLayout title={title} description={description}>
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 flex gap-8">
    <Sidebar />

    <main class="flex-1 min-w-0 py-10 lg:py-12">
      <!-- Breadcrumb -->
      {
        title && (
          <nav
            class="flex items-center gap-1.5 text-xs text-gray-400 dark:text-gray-500 mb-6 font-medium"
            aria-label="Breadcrumb"
          >
            <a
              href={`${base}/`}
              class="hover:text-primary-500 transition-colors"
            >
              Home
            </a>
            <svg
              class="w-3 h-3"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
            <span class="text-gray-600 dark:text-gray-300 truncate">
              {title}
            </span>
          </nav>
        )
      }

      <!-- Content -->
      <article
        class="prose prose-gray dark:prose-invert max-w-3xl
        prose-headings:font-bold prose-headings:tracking-tight prose-headings:scroll-mt-24
        prose-h1:text-3xl prose-h1:mb-4
        prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b prose-h2:border-gray-200 prose-h2:dark:border-white/10 prose-h2:pb-3
        prose-h3:text-xl prose-h3:mt-8
        prose-a:text-primary-600 dark:prose-a:text-primary-400 prose-a:no-underline hover:prose-a:underline
        prose-code:text-primary-700 dark:prose-code:text-primary-300
        prose-strong:text-gray-900 dark:prose-strong:text-white
        prose-blockquote:border-l-primary-400 prose-blockquote:bg-primary-50/50 dark:prose-blockquote:bg-primary-500/5 prose-blockquote:rounded-r-lg prose-blockquote:py-0.5
        prose-table:text-sm
        prose-th:bg-gray-50 dark:prose-th:bg-white/[0.04]
        prose-img:rounded-xl prose-img:shadow-lg
        prose-hr:border-gray-200 dark:prose-hr:border-white/10"
      >
        <slot />
      </article>

      <!-- Prev / Next -->
      <div
        class="mt-16 pt-8 border-t border-gray-200 dark:border-white/[0.08] flex justify-between items-stretch gap-4"
      >
        {
          prev ? (
            <a
              href={`${base}${prev.href}`}
              class="group flex flex-col gap-1 p-4 rounded-xl border border-gray-200 dark:border-white/[0.08] hover:border-primary-300 dark:hover:border-primary-500/40 text-left transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md"
            >
              <span class="text-xs text-gray-400 dark:text-gray-500 flex items-center gap-1 font-medium">
                <svg
                  class="w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M11 17l-5-5m0 0l5-5m-5 5h12"
                  />
                </svg>
                Previous
              </span>
              <span class="text-sm font-semibold text-gray-700 dark:text-gray-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {prev.title}
              </span>
            </a>
          ) : (
            <div />
          )
        }

        {
          next ? (
            <a
              href={`${base}${next.href}`}
              class="group flex flex-col gap-1 p-4 rounded-xl border border-gray-200 dark:border-white/[0.08] hover:border-primary-300 dark:hover:border-primary-500/40 text-right transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md ml-auto"
            >
              <span class="text-xs text-gray-400 dark:text-gray-500 flex items-center justify-end gap-1 font-medium">
                Next
                <svg
                  class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 7l5 5m0 0l-5 5m5-5H6"
                  />
                </svg>
              </span>
              <span class="text-sm font-semibold text-gray-700 dark:text-gray-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {next.title}
              </span>
            </a>
          ) : (
            <div />
          )
        }
      </div>
    </main>
  </div>
</BaseLayout>
