# OpsAgent configuration
#
# Copy this file to .env and fill in ONE provider block.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit a real key.
#
# Four variables configure every provider. Which ones you need depends on
# LLM_PROVIDER — run `uv run python -m providers` to print the full list.
#
#   LLM_PROVIDER   which provider to use        (always)
#   LLM_API_KEY    the credential               (most providers)
#   LLM_MODEL      the model or deployment id   (always)
#   LLM_BASE_URL   the endpoint                 (some providers)
#
# There are no default model names anywhere in this project. Provider
# catalogues change, and a default that quietly rots into a 404 six months from
# now is worse than being asked to name the model you want.

# ---------------------------------------------------------------------------
# Google AI Studio — the workshop default
# Free tier, no card required: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Ollama — fully local, the fallback when the wifi gives out
# Install https://ollama.com, then: ollama pull llama3.2
# Not every local model can call tools; llama3.2 and qwen3:4b can.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434   # optional, this is the default

# ---------------------------------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Azure OpenAI
# LLM_MODEL is your DEPLOYMENT name, which is not always the model name.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=azure-openai
# LLM_API_KEY=
# LLM_MODEL=my-gpt-4o-mini-deployment
# LLM_BASE_URL=https://<your-resource>.openai.azure.com

# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint
# The catch-all: OpenRouter, Groq, Cerebras, Together, Fireworks, DeepSeek,
# xAI, LM Studio, vLLM — anything that speaks the OpenAI wire format.
# Several have free tiers worth knowing about now that GitHub Models is gone.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Anthropic — https://console.anthropic.com
# Needs: uv sync --extra anthropic
# ---------------------------------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Microsoft Foundry
# Authenticates with `az login`, so there is no API key.
# Needs: uv sync --extra foundry
# ---------------------------------------------------------------------------
# LLM_PROVIDER=foundry
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://<your-project>.services.ai.azure.com

# ---------------------------------------------------------------------------
# Foundry Local — Foundry models on this machine
# Requires the Foundry Local runtime on PATH. First run downloads the model.
# Needs: uv sync --extra foundry-local
# ---------------------------------------------------------------------------
# LLM_PROVIDER=foundry-local
# LLM_MODEL=phi-4-mini

# ---------------------------------------------------------------------------
# Amazon Bedrock
# Region and credentials come from the standard AWS chain, not from LLM_*.
# Needs: uv sync --extra bedrock
# ---------------------------------------------------------------------------
# LLM_PROVIDER=bedrock
# LLM_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
